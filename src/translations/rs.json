    "general_info": {
      "title": [
        "arthrys_content",
        {
          "text": "Šta je ARTHRYS"
        }
      ],
      "text": [
        [
          "arthrys_content",
          {
            "text": "Bol, preopterećenje ili povratak pokretu nakon povrede su situacije sa kojima se tokom života susretne gotovo svako. Aktivan način života, sport, ali i svakodnevno opterećenje mogu usporavati prirodnu regeneraciju organizma i smanjivati komfor pri kretanju."
          }
        ],
        [
          "arthrys_content",
          {
            "font": {
              "bold": true
            },
            "text": "ARTHRYS"
          },
          {
            "text": " je moderan i inovativan proizvod namenjen podršci regeneraciji lokomotornog sistema i komforu pri kretanju. Zasnovan je na primeni niskomolekularnih peptida, koji su organizmu prirodno bliski i dizajnirani su tako da podrže prirodne regenerativne procese tela."
          }
        ],
        [
          "arthrys_content",
          {
            "text": "Zahvaljujući svom niskomolekularnom sastavu, pojedini peptidi se lako apsorbuju i mogu efikasno dopuniti brigu o lokomotornom sistemu u periodima povećanog opterećenja, pri povratku aktivnosti nakon povreda ili kod dugotrajnog opterećenja mišića i zglobova."
          }
        ],
        [
          "arthrys_content",
          {
            "font": {
              "bold": true
            },
            "text": "ARTHRYS"
          },
          {
            "text": " predstavlja moderan pristup regeneraciji - podržava organizam kako bi se prirodno vratio pokretu i aktivnosti bez nepotrebnih ograničenja."
          }
        ],
        [
          "arthrys_content",
          {
            "font": {
              "bold": true
            },
            "text": "Saznajte više o lečenju mišićno-skeletnog sistema"
          }
        ]
      ],
      "button": [
        "arthrys_content",
        {
          "text": "Saznajte više"
        }
      ]
    },
    "effects": {
      "title": [
        "arthrys_content",
        {
          "text": "Pomoću čega ARTHRYS pokreće prirodnu regeneraciju?"
        }
      ],
      "effects_list": [
        {
          "title": [
            "arthrys_content",
            {
              "text": "Počinje smanjenjem upale i bola"
            }
          ],
          "text": [
            {
              "title": [
                "arthrys_content",
                {
                  "text": "SMANJENJE UPALE I BOLA"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "LWP u ARTHRYSu učestvuju u složenim interakcijama unutar ćelijskih signalnih mreža. Oni specifično ciljaju na inflamatorne puteve vezivanjem za receptore i inhibiranjem enzima koji pokreću upalu. Modulacijom ovih ćelijskih aktivnosti, LWP pomažu u obnavljanju uravnoteženog imunološkog odgovora koji je ključan za smanjenje hronične upale."
                }
              ]
            },
            {
              "title": [
                "arthrys_content",
                {
                  "text": "INHIBICIJA DEGRADACIJE TKIVA"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "Litički enzimi kao što su matrične metaloproteinaze (MMP) igraju ključnu ulogu u degradaciji tkiva. LWP inhibiraju prekomernu aktivnost ovih enzima, ograničavaju prekomernu degradaciju komponenti vanćelijskog matriksa, smanjujući na taj način upalu i prateći bol."
                }
              ]
            }
          ]
        },
        {
          "title": [
            "arthrys_content",
            {
              "text": "Nastavlja se jačanjem i regeneracijom tkiva"
            }
          ],
          "text": [
            {
              "title": [
                "arthrys_content",
                {
                  "text": "STIMULACIJA PROIZVODNJE KOLAGENA"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "LWP stimulišu fibroblaste i hondrocite da povećaju sintezu kolagena, glavne komponente hrskavice i vezivnog tkiva. Ova selektivna stimulacija je od vitalnog značaja za održavanje integriteta tkiva i olakšavanje procesa zaceljenja."
                }
              ]
            },
            {
              "title": [
                "arthrys_content",
                {
                  "text": "PODRŠKA REGENERACIJI TKIVA"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "Reparacija tkiva obično rezultira formiranjem ožiljaka koji su funkcionalno inferiorni u odnosu na prvobitno tkivo. LWP pomeraju odgovor tela ka regeneraciji, promovišući na taj način formiranje tkiva koje su po strukturi i funkciji sličnije njihovom prvobitnom stanju."
                }
              ]
            }
          ]
        },
        {
          "title": [
            "arthrys_content",
            {
              "text": "I završava se poboljšanom mobilnošću"
            }
          ],
          "text": [
            {
              "title": [
                "arthrys_content",
                {
                  "text": "ODRŽAVANJE ZDRAVLJA HRSKAVICE"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "Hrskavica, tkivo za amortizovanje zglobova se vremenom troši. LW peptidi pomažu u održavanju zdravlja hrskavice tako što podržavaju sintezu njenih esencijalnih komponenti i sprečavaju njenu razgradnju, čime se čuva funkcionalnost zglobova."
                }
              ]
            },
            {
              "title": [
                "arthrys_content",
                {
                  "text": "POVEĆANA POKRETLJIVOST ZGLOBOVA ZAHVALJUJUĆI ZDRAVOJ HRSKAVICI"
                }
              ],
              "desc": [
                "arthrys_content",
                {
                  "text": "Poboljšano zdravlje hrskavice direktno se prevodi u poboljšanu pokretljivost zglobova. Zglobovi postaju fleksibilniji i manje bolni, omogućavajući glatko kretanje i bolji opseg pokreta."
                }
              ]
            }
          ]
        }
      ]
    },
